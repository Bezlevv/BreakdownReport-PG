@inject BreakdownReport.Services.DictionaryStore Store
@{
    var winLogin = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
    if (winLogin is not null && winLogin.Contains('\\'))
        winLogin = winLogin.Split('\\')[^1];

    int.TryParse(Context.Request.Cookies["currentUserId"], out var cookieId);
    var currentUser = (winLogin is not null ? Store.FindByLogin(winLogin) : null)
        ?? Store.Employees.FirstOrDefault(e => e.Id == cookieId);
    var currentUserId = currentUser?.Id ?? 0;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Учёт поломок</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        if (localStorage.getItem('theme') === 'dark')
            document.documentElement.setAttribute('data-bs-theme', 'dark');
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Breakdowns/Index">Учёт поломок</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-page="/Breakdowns/Index">Поломки</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Breakdowns/Create">Добавить</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Reports">Отчёты</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Modernizations/Index">Модернизации</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Modernizations/Reports">Отчёты (модернизации)</a></li>
                    </ul>
                    @if (currentUser is not null && winLogin is not null)
                    {
                        <span class="small text-muted">Сейчас работает: <b>@currentUser.FullName</b></span>
                    }
                    else
                    {
                        <form method="get" action="/SetUser" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <span class="small text-muted">Кто заполняет?</span>
                            <select name="userId" class="form-select form-select-sm w-auto">
                                @foreach (var e in Store.Employees)
                                {
                                    <option value="@e.Id" selected="@(e.Id == currentUserId ? "selected" : null)">@e.FullName</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Это я</button>
                        </form>
                    }
                    <button id="themeToggle" type="button" class="btn btn-sm btn-outline-secondary ms-2" title="Переключить тему">🌓</button>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 — АО "Романов"
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('themeToggle').addEventListener('click', function () {
            var next = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', next);
            localStorage.setItem('theme', next);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>