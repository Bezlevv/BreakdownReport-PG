@page
@model BreakdownReport.Pages.Breakdowns.IndexModel

@{
    ViewData["Title"] = "История поломок";
    var total = Model.Items.Count;
    var month = Model.Items.Count(b => b.OccurredAt.Month == DateTime.Now.Month && b.OccurredAt.Year == DateTime.Now.Year);
    var thirdParty = Model.Items.Count(b => b.ThirdPartyFault);
    var downtime = Model.Items.Sum(b => b.LineDowntimeMinutes);
    var labor = Model.Items.Sum(b => b.TotalLaborMinutes);
}

<h2>История поломок</h2>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-2">
        <label class="form-label">С</label>
        <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-md-2">
        <label class="form-label">По</label>
        <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Участок</label>
        <select name="AreaId" class="form-select form-select-sm">
            <option value="">Все</option>
            @foreach (var a in Model.Store.Areas)
            {
                <option value="@a.Id" selected="@(Model.AreaId == a.Id ? "selected" : null)">@a.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Оборудование</label>
        <select name="EquipmentId" class="form-select form-select-sm">
            <option value="">Все</option>
            @foreach (var e in Model.Store.Equipment)
            {
                <option value="@e.Id" selected="@(Model.EquipmentId == e.Id ? "selected" : null)">
                    @Model.Store.FindArea(e.AreaId)?.Name — @e.Name
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Автор</label>
        <select name="AuthorId" class="form-select form-select-sm">
            <option value="">Все</option>
            @foreach (var e in Model.Store.Employees)
            {
                <option value="@e.Id" selected="@(Model.AuthorId == e.Id ? "selected" : null)">@e.FullName</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Участник бригады</label>
        <select name="CrewMemberId" class="form-select form-select-sm">
            <option value="">Все</option>
            @foreach (var e in Model.Store.Employees)
            {
                <option value="@e.Id" selected="@(Model.CrewMemberId == e.Id ? "selected" : null)">@e.FullName</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Вина третьих лиц</label>
        <select name="FaultFilter" class="form-select form-select-sm">
            <option value="" selected="@(Model.FaultFilter is null ? "selected" : null)">Все</option>
            <option value="yes" selected="@(Model.FaultFilter == "yes" ? "selected" : null)">ДА</option>
            <option value="no" selected="@(Model.FaultFilter == "no" ? "selected" : null)">нет</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Поиск</label>
        <input type="search" name="Search" value="@Model.Search" class="form-control form-control-sm" placeholder="в описании" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary">Найти</button>
        <a class="btn btn-sm btn-outline-secondary" href="/Breakdowns">Сбросить</a>
    </div>
</form>

<div class="mb-2 d-flex flex-wrap gap-2 align-items-center">
    <a class="btn btn-success" asp-page="/Breakdowns/Create">+ Добавить поломку</a>
    <a class="btn btn-outline-success"
       asp-page="/Breakdowns/Index" asp-page-handler="Export"
       asp-route-From="@Model.From?.ToString("yyyy-MM-dd")"
       asp-route-To="@Model.To?.ToString("yyyy-MM-dd")"
       asp-route-AreaId="@Model.AreaId"
       asp-route-EquipmentId="@Model.EquipmentId"
       asp-route-AuthorId="@Model.AuthorId"
       asp-route-CrewMemberId="@Model.CrewMemberId"
       asp-route-FaultFilter="@Model.FaultFilter"
       asp-route-Search="@Model.Search">📥 Excel</a>
    <span class="text-muted">Найдено: @total</span>
</div>

<div class="mb-3">
    <span class="badge bg-secondary">Всего: @total</span>
    <span class="badge bg-primary">За месяц: @month</span>
    <span class="badge bg-danger">Вина третьих лиц: @thirdParty</span>
    <span class="badge bg-warning text-dark">Простой линии: @downtime мин</span>
    <span class="badge bg-info text-dark">Трудозатраты: @labor мин</span>
</div>

<table class="table table-sm table-bordered align-middle">
    <thead>
        <tr>
            <th>№</th>
            <th>Дата</th>
            <th>Участок</th>
            <th>Оборудование</th>
            <th>Короткое описание</th>
            <th>Простой линии</th>
            <th>Простой об-я</th>
            <th>Трудозатраты</th>
            <th>Вина 3-х лиц</th>
            <th>Автор</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Items)
        {
            <tr>
                <td><a asp-page="/Breakdowns/Details" asp-route-id="@b.Id">@b.Id</a></td>
                <td>@b.OccurredAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@Model.AreaNameByEquipment(b.EquipmentId)</td>
                <td>@Model.EquipmentName(b.EquipmentId)</td>
                <td>@b.ShortDescription</td>
                <td>@b.LineDowntimeMinutes мин</td>
                <td>@b.EquipmentDowntimeMinutes мин</td>
                <td>@b.TotalLaborMinutes мин</td>
                <td>
                    @if (b.ThirdPartyFault)
                    {
                        <span class="badge bg-danger">ДА</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">НЕТ</span>
                    }
                </td>
                <td>@Model.EmployeeName(b.AuthorId)</td>
                <td><a class="btn btn-sm btn-outline-secondary" asp-page="/Breakdowns/Edit" asp-route-id="@b.Id">Ред.</a></td>
            </tr>
        }
    </tbody>
</table>