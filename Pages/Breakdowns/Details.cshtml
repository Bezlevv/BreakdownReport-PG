@page "{id:int}"
@model BreakdownReport.Pages.Breakdowns.DetailsModel

@if (Model.Item is null)
{
    <div class="alert alert-warning mt-3">Запись не найдена.</div>
    <a class="btn btn-sm btn-outline-secondary" href="/Breakdowns">← К списку</a>
}
else
{
    var b = Model.Item;
    var eq = Model.Store.Equipment.FirstOrDefault(e => e.Id == b.EquipmentId);
    var area = eq is not null ? Model.Store.FindArea(eq.AreaId) : null;
    var type = Model.Store.FailureTypes.FirstOrDefault(t => t.Id == b.FailureTypeId);

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h2 class="me-auto mb-0">Поломка #@b.Id</h2>
        <a class="btn btn-sm btn-outline-secondary" href="/Breakdowns">← К списку</a>
        <a class="btn btn-sm btn-primary" asp-page="/Breakdowns/Edit" asp-route-id="@b.Id">✏️ Изменить</a>
        @if (Model.IsAdmin)
        {
            <form method="post" asp-page-handler="Delete" asp-route-id="@b.Id"
                  onsubmit="return confirm('Удалить запись вместе с вложениями?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">🗑 Удалить</button>
            </form>
        }
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <table class="table table-sm align-middle mb-0">
                <tbody>
                    <tr><th style="width:30%">Дата и время возникновения</th><td>@b.OccurredAt.ToString("dd.MM.yyyy HH:mm")</td></tr>
                    <tr><th>Участок</th><td>@(area?.Name ?? "—")</td></tr>
                    <tr><th>Оборудование</th><td>@(eq?.Name ?? "—")</td></tr>
                    <tr><th>Тип поломки</th><td>@(type?.Name ?? "—")</td></tr>
                    <tr><th>Короткое описание</th><td>@b.ShortDescription</td></tr>
                    <tr><th>Подробное описание</th><td>@b.DetailedDescription</td></tr>
                    <tr><th>Простой линии</th><td><span class="badge bg-warning text-dark">@b.LineDowntimeMinutes мин</span></td></tr>
                    <tr><th>Простой оборудования</th><td><span class="badge bg-info text-dark">@b.EquipmentDowntimeMinutes мин</span></td></tr>
                    <tr>
                        <th>Вина третьих лиц</th>
                        <td>
                            @if (b.ThirdPartyFault)
                            {
                                <span class="badge bg-danger">ДА</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">нет</span>
                            }
                        </td>
                    </tr>
                    <tr><th>Автор</th><td>@Model.EmployeeName(b.AuthorId)</td></tr>
                    <tr>
                        <th>Бригада и трудозатраты</th>
                        <td>
                            @if (b.LaborEntries.Count == 0)
                            {
                                <text>—</text>
                            }
                            else
                            {
                                <ul class="mb-1">
                                    @foreach (var l in b.LaborEntries)
                                    {
                                        <li>@Model.EmployeeName(l.EmployeeId) — @l.Minutes мин</li>
                                    }
                                </ul>
                                <span class="badge bg-primary">Итого: @b.TotalLaborMinutes мин</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <h4 class="mb-3">📎 Вложения (фото, скриншоты экранов с ошибками)</h4>
    @if (Model.Attachments.Count == 0)
    {
        <p class="text-muted">Вложений нет.</p>
    }
    else
    {
        <div class="d-flex flex-wrap gap-3 mb-3">
            @foreach (var name in Model.Attachments)
            {
                <div class="text-center border rounded p-2">
                    <a href="/attachments/@b.Id/@name" target="_blank">
                        <img src="/attachments/@b.Id/@name" alt="@name"
                             style="max-height:120px; max-width:180px" />
                    </a>
                    @if (Model.IsAdmin)
                    {
                        <form method="post" asp-page-handler="DeleteFile"
                              asp-route-id="@b.Id" asp-route-fileName="@name"
                              onsubmit="return confirm('Удалить вложение?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger mt-1">✕ удалить</button>
                        </form>
                    }
                </div>
            }
        </div>
    }

    <form method="post" enctype="multipart/form-data"
          asp-page-handler="Upload" asp-route-id="@b.Id"
          class="mb-4 d-flex gap-2 align-items-center">
        <input type="file" name="files" multiple accept="image/*,.pdf" class="form-control form-control-sm w-auto" />
        <button type="submit" class="btn btn-sm btn-success">📎 Прикрепить</button>
    </form>

    <h4 class="mb-3">🕘 История изменений</h4>
    @if (Model.Audit.Count == 0)
    {
        <p class="text-muted">Изменений пока не зафиксировано.</p>
    }
    else
    {
        <table class="table table-sm table-bordered align-middle">
            <thead>
                <tr><th>Когда</th><th>Кто</th><th>Действие</th><th>Подробности</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Audit)
                {
                    <tr>
                        <td>@a.At.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@a.UserName</td>
                        <td>@a.Action</td>
                        <td>@a.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}